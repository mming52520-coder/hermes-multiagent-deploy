# Hermes 多 Agent 部署参数
#
# 已按现有接口预配置：
#   orchestrator -> PackyAPI claude-officially
#   researcher   -> DeepSeek 官方 API
#   builder      -> PackyAPI codex
#   reviewer     -> PackyAPI claude-officially
#
# 只在本机填写完整密钥；不要把 deploy.env 提交到 Git，也不要把密钥粘贴到聊天中。
#
# 模型选择：负责规划和决策的 Orchestrator 应使用你能用到的最强模型，不要用弱模型指挥强模型。
# 下面的模型 ID 是历史默认值，以你所用服务商控制台实际列出的 ID 为准，填好后运行模型预检。

# ---------- 主机与项目 ----------
HERMES_USER=hermes
PROJECT_SLUG=my-project
BOARD_SLUG=my-project
BOARD_NAME="My Project"
PROJECT_DIR=/srv/hermes/projects/my-project
PROJECT_GIT_URL=
PROJECT_GIT_REF=main
OUTPUT_DIR=/srv/hermes/outputs/my-project
BACKUP_DIR=/srv/hermes/backups

# ---------- PackyAPI ----------
# PackyAPI 控制台：名称 claude official / 分组 claude-officially
PACKY_CLAUDE_API_KEY=replace-with-full-claude-officially-token

# PackyAPI 控制台：名称 codex / 分组 codex
PACKY_CODEX_API_KEY=replace-with-full-codex-token

# 已创建但默认不使用；保留为后续切换入口。
# PackyAPI 控制台：名称 deepseek / 分组 deepseek-officially
PACKY_DEEPSEEK_API_KEY=
# PackyAPI 控制台：名称 claude code / 分组 cc-sale
PACKY_CC_SALE_API_KEY=

PACKY_CLAUDE_BASE_URL=https://www.packyapi.com
PACKY_CODEX_BASE_URL=https://www.packyapi.com/v1
PACKY_DEEPSEEK_BASE_URL=https://www.packyapi.com/v1
PACKY_CC_SALE_BASE_URL=https://www.packyapi.com

# ---------- DeepSeek 官方 ----------
DEEPSEEK_API_KEY=replace-with-full-deepseek-official-key

# ---------- 四个 Agent 的模型 ----------
# Packy Claude 使用 Anthropic Messages。
ORCHESTRATOR_PROVIDER=custom:packy-claude
ORCHESTRATOR_MODEL=claude-sonnet-4-6
ORCHESTRATOR_CONTEXT_LENGTH=200000

# DeepSeek 官方使用 Hermes 内置 deepseek provider。
# deepseek-chat / deepseek-reasoner 将在 2026-07-24 弃用，因此使用新模型名。
RESEARCHER_PROVIDER=deepseek
RESEARCHER_MODEL=deepseek-v4-pro
RESEARCHER_CONTEXT_LENGTH=1000000

# Packy Codex 使用 OpenAI Responses。
# 模型 ID 必须以 PackyAPI“模型广场”中 codex 分组实际显示为准。
BUILDER_PROVIDER=custom:packy-codex
BUILDER_MODEL=gpt-5.2
BUILDER_CONTEXT_LENGTH=0

# Reviewer 使用不同于 Builder 的 Claude 通道做独立审查。
REVIEWER_PROVIDER=custom:packy-claude
REVIEWER_MODEL=claude-sonnet-4-6
REVIEWER_CONTEXT_LENGTH=200000

# ---------- 可选：外部 Web Search ----------
EXA_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=

# ---------- 可选：Telegram，仅 Orchestrator 对外 ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---------- 运行参数 ----------
DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
MAX_IN_PROGRESS=2
MAX_IN_PROGRESS_PER_PROFILE=1
DISPATCH_INTERVAL_SECONDS=15
WORKER_CPU=2
RESEARCHER_MEMORY_MB=3072
BUILDER_MEMORY_MB=6144
REVIEWER_MEMORY_MB=4096

# 安装前分别发送一个极小请求，验证 Token、Endpoint 和模型 ID。
RUN_PROVIDER_PREFLIGHT=true

# 部署完成后执行只读端到端 Smoke Test。
RUN_SMOKE_TEST=true

# ---------- P0 受控工作流：默认只创建 triage 卡，不自动派发写入 ----------
# 操作员显式 start --approve-write 才授权候选目录写入。
# 操作员设置的真实验收命令；不执行 Agent 提供的任意测试命令。
WORKFLOW_TEST_COMMAND=
WORKFLOW_MAX_REPAIR_ROUNDS=2
WORKFLOW_MAX_SECONDS=7200
# 原生 task run 尝试次数，不能冒充模型请求次数。
WORKFLOW_MAX_RUNS=12
# 设置硬费用上限时，旧版无法提供可信账单/硬限额接口，将拒绝继续。
WORKFLOW_MAX_COST_USD=
# ---------- 授权范围与自动验收 ----------
# true：平台测试通过、Reviewer 无阻断问题、改动不碰下列敏感类别时，自动验收，不再等人点击。
# 敏感类别（始终需要人决定）：数据库结构/迁移、CI/部署/权限配置、密钥/凭据、新增或升级依赖、删除文件。
# 设置在创建任务时固定到该任务，之后修改不影响已创建的任务。默认 false，保持原来的人工验收。
WORKFLOW_AUTO_ACCEPT=false
# 改动文件超过此数量时也交给人决定。
WORKFLOW_AUTO_ACCEPT_MAX_FILES=20
# 额外需要人决定的路径，逗号分隔的 glob，例如 billing/*,src/payments/*
WORKFLOW_DECISION_PATHS=

# ---------- 飞书决策卡片（唯一出口） ----------
# 飞书群 → 设置 → 群机器人 → 添加自定义机器人，复制 Webhook 地址。地址等同密钥，不要提交到 Git。
# 只在需要你决定时推送：待确认交付、审查发现阻断问题、任务需要人工处理。每个决策点只推一次。
FEISHU_WEBHOOK_URL=
# 机器人「安全设置」中开启签名校验时填写。
FEISHU_WEBHOOK_SECRET=
# 卡片按钮跳转的 Dashboard 地址，例如 http://127.0.0.1:9119
WORKFLOW_DASHBOARD_URL=

# 可选：同目标/版本的新实例名。旧 JOB_KEY 仍支持，并纳入 source revision。
WORKFLOW_EXECUTION_ID=
# 非 Git 安装可用固定源码归档校验实际源码，不仅比较版本号。
HERMES_BASELINE_ARCHIVE=
# 可选：已验证 Hermes 安装的 Python。
HERMES_PYTHON=
