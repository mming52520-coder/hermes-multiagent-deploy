+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { I18nProvider, useI18n } from "./context";
+import { translateUi } from "./ui-messages";
+import { LanguageToggle } from "@/components/LanguageSwitcher";
+import { isoTimeAgo, timeAgo } from "@/lib/utils";
+
+function ModelSettings() {
+  const { msg, t } = useI18n();
+  return <><LanguageToggle /><h1>{t.app.nav.models}</h1><h2>{msg("Model Settings")}</h2><p>{msg("Main model")}</p></>;
+}
+
+let container: HTMLDivElement;
+let root: Root | undefined;
+
+async function mount() {
+  root = createRoot(container);
+  await act(async () => root!.render(<I18nProvider><ModelSettings /></I18nProvider>));
+}
+
+function button(label: string) {
+  const found = Array.from(container.querySelectorAll("button")).find((element) => element.textContent === label);
+  if (!found) throw new Error(`Missing language button: ${label}`);
+  return found;
+}
+
+beforeEach(() => {
+  (globalThis as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true;
+  localStorage.clear();
+  container = document.createElement("div");
+  document.body.append(container);
+});
+
+afterEach(async () => {
+  await act(async () => root?.unmount());
+  root = undefined;
+  container.remove();
+  localStorage.clear();
+});
+
+describe("Chinese / English toolbar", () => {
+  it("defaults to Chinese for a first visit", async () => {
+    await mount();
+    expect(container.querySelector("h1")?.textContent).toBe("模型");
+    expect(container.querySelector("h2")?.textContent).toBe("模型设置");
+    expect(container.querySelector("p")?.textContent).toBe("主模型");
+    expect(button("中文").getAttribute("aria-pressed")).toBe("true");
+    expect(document.documentElement.lang).toBe("zh");
+    expect(document.title).toBe("Hermes 多智能体工作台");
+  });
+
+  it("switches native and newly translated copy together and remembers the choice", async () => {
+    await mount();
+    await act(async () => button("English").click());
+    expect(container.querySelector("h1")?.textContent).toBe("Models");
+    expect(container.querySelector("h2")?.textContent).toBe("Model Settings");
+    expect(container.querySelector("p")?.textContent).toBe("Main model");
+    expect(localStorage.getItem("hermes-locale")).toBe("en");
+    expect(document.documentElement.lang).toBe("en");
+    expect(document.title).toBe("Hermes Agent - Dashboard");
+    await act(async () => root!.unmount());
+    await mount();
+    expect(button("English").getAttribute("aria-pressed")).toBe("true");
+    await act(async () => button("中文").click());
+    expect(container.querySelector("h2")?.textContent).toBe("模型设置");
+    expect(localStorage.getItem("hermes-locale")).toBe("zh");
+  });
+
+  it("respects an existing language choice", async () => {
+    localStorage.setItem("hermes-locale", "en");
+    await mount();
+    expect(container.querySelector("h2")?.textContent).toBe("Model Settings");
+    expect(button("English").getAttribute("aria-pressed")).toBe("true");
+  });
+});
+
+describe("app-owned interface copy", () => {
+  it("translates labels while preserving supplied names, model IDs and logs", () => {
+    const value = "openrouter/custom_MODEL — Main model\nraw log";
+    expect(translateUi("zh", "Preview failed: {0}", value)).toBe(`预览失败：${value}`);
+    expect(translateUi("en", "Preview failed: {0}", value)).toBe(`Preview failed: ${value}`);
+    expect(translateUi("zh", value)).toBe(value);
+  });
+
+  it("uses the selected language for relative timestamps", () => {
+    const past = Date.now() / 1000 - 7200;
+    expect(timeAgo(past, "zh")).toBe("2 小时前");
+    expect(timeAgo(past, "en")).toBe("2h ago");
+    expect(isoTimeAgo(new Date(past * 1000).toISOString(), "zh")).toBe("2 小时前");
+    expect(isoTimeAgo("invalid", "zh")).toBe("未知");
+  });
+});
