+};
+
+export function translateUi(locale: string, source: string, ...values: unknown[]): string {
+  const key = source.replace(/\s+/g, " ").trim();
+  const text = locale === "zh" ? UI_ZH[key] ?? source : source;
+  return text.replace(/\{(\d+)\}/g, (token, index: string) => Number(index) < values.length ? String(values[Number(index)]) : token);
+}
