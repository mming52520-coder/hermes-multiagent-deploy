+import { useEffect, useState, type FormEvent } from "react";
+import { Link } from "react-router";
+import { Button } from "@nous-research/ui/ui/components/button";
+import { Input } from "@nous-research/ui/ui/components/input";
+import { Label } from "@nous-research/ui/ui/components/label";
+import { Spinner } from "@nous-research/ui/ui/components/spinner";
+import { api, type CustomModelEndpoint, type ModelOptionProvider } from "@/lib/api";
+import { errorMessage } from "@/lib/api-error";
+import { useI18n } from "@/i18n";
+import { PROVIDER_API_DEFAULTS } from "@/lib/provider-api-defaults";
+
+export type ModelSetupStatus = "loading" | "ready" | "saving" | "login";
+
+interface Props {
+  provider: ModelOptionProvider;
+  profile: string;
+  model: string;
+  onSaved(provider: string, model: string): Promise<void>;
+  onCancel(): void;
+  onClose(): void;
+  onSelectProvider(provider: string): void;
+  onStatusChange(status: ModelSetupStatus): void;
+}
+
+export function ModelProviderSetup({ provider, profile, model, onSaved, onCancel, onClose, onSelectProvider, onStatusChange }: Props) {
+  const { msg: ui } = useI18n();
+  const newCustom = provider.slug === "__new_custom__" || (provider.slug === "custom" && !provider.api_url);
+  const custom = provider.is_user_defined || provider.slug === "custom" || newCustom;
+  const defaults = PROVIDER_API_DEFAULTS[provider.slug];
+  const [keyEnv, setKeyEnv] = useState("");
+  const [baseUrlEnv, setBaseUrlEnv] = useState("");
+  const [routingUrl, setRoutingUrl] = useState(provider.api_url || defaults?.baseUrl || "");
+  const [routingChanged, setRoutingChanged] = useState(false);
+  const [hasKey, setHasKey] = useState(false);
+  const [endpoint, setEndpoint] = useState<CustomModelEndpoint | null>(null);
+  const [name, setName] = useState(newCustom ? "" : provider.name);
+  const [baseUrl, setBaseUrl] = useState(custom ? provider.api_url || "" : "");
+  const [modelName, setModelName] = useState(model);
+  const [apiKey, setApiKey] = useState("");
+  const [protocol, setProtocol] = useState(provider.slug === "anthropic" ? "anthropic_messages" : "chat_completions");
+  const [loading, setLoading] = useState(!newCustom);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (newCustom) return;
+    let cancelled = false;
+    const load = async () => {
+      if (custom) {
+        const result = await api.getCustomModelEndpoints(profile);
+        const saved = result.endpoints.find((entry) =>
+          [entry.id, entry.name, `custom:${entry.name}`].some((alias) =>
+            alias.toLowerCase() === provider.slug.toLowerCase() || provider.aliases?.includes(alias.toLowerCase()),
+          ),
+        );
+        if (cancelled || !saved) return;
+        setEndpoint(saved);
+        setName(saved.name);
+        setBaseUrl(saved.base_url);
+        setModelName(model || saved.model);
+        setProtocol(saved.api_mode || "");
+        setHasKey(saved.has_api_key);
+      } else {
+        const env = await api.getEnvVars(profile);
+        const key = provider.key_env || Object.keys(env).find((key) =>
+          (env[key].provider === provider.slug && env[key].provider_primary) ||
+          env[key].provider_profiles?.some((entry) => entry.provider === provider.slug && entry.primary),
+        ) || "";
+        if (cancelled) return;
+        setKeyEnv(key);
+        setHasKey(!!env[key]?.is_set);
+        setBaseUrlEnv(Object.keys(env).find((field) => env[field].provider === provider.slug && env[field].advanced && !env[field].is_password) || "");
+      }
+    };
+    load().catch((e) => !cancelled && setError(errorMessage(e)))
+      .finally(() => !cancelled && setLoading(false));
+    return () => { cancelled = true; };
+  }, [provider, profile, custom, newCustom, model]);
+
+  const customRoute = custom || !!baseUrl.trim();
+  const savedKey = customRoute ? endpoint?.has_api_key : hasKey;
+  const needsLogin = !custom && !keyEnv;
+  useEffect(() => {
+    onStatusChange(loading ? "loading" : saving ? "saving" : needsLogin ? "login" : "ready");
+  }, [loading, saving, needsLogin, onStatusChange]);
+
+  const save = async (event: FormEvent) => {
+    event.preventDefault();
+    setSaving(true);
+    setError(null);
+    try {
+      let selected = provider.slug;
+      if (customRoute) {
+        const result = await api.saveCustomModelEndpoint({
+          ...(endpoint ? { id: endpoint.id } : {}),
+          name: custom ? name.trim() : `${provider.name} API`,
+          base_url: baseUrl.trim(),
+          model: modelName.trim(),
+          ...(apiKey.trim() ? { api_key: apiKey.trim() } : {}),
+          api_mode: protocol,
+          discover_models: endpoint?.discover_models ?? false,
+        }, profile);
+        selected = result.id;
+        setEndpoint(result.endpoints.find((entry) => entry.id === result.id) || endpoint);
+      } else {
+        if (routingChanged) await api.setEnvVar(baseUrlEnv, routingUrl, profile);
+        if (apiKey.trim()) {
+          await api.setEnvVar(keyEnv, apiKey.trim(), profile);
+          setHasKey(true);
+        }
+      }
+      setApiKey("");
+      await onSaved(selected, customRoute ? modelName.trim() : "");
+    } catch (e) {
+      setError(errorMessage(e));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  if (loading) return <div className="p-4 text-xs"><Spinner /> {ui("Loading connection settings…")}</div>;
+
+  if (needsLogin && !error) {
+    return (
+      <div className="p-4 space-y-3 text-xs">
+        <p>{ui("This provider uses an account login rather than an API key.")}</p>
+        {provider.slug === "openai-codex" && (
+          <>
+            <p className="text-muted-foreground">{ui("For an OpenAI API key, choose OpenAI API instead.")}</p>
+            <Button outlined onClick={() => onSelectProvider("openai-api")}>{ui("Use OpenAI API")}</Button>
+          </>
+        )}
+        <Link to={`/env?profile=${encodeURIComponent(profile)}`} onClick={onClose} className="block underline">
+          {ui("Open account sign-in")}
+        </Link>
+        <Button ghost onClick={onCancel}>{ui("Back to models")}</Button>
+      </div>
+    );
+  }
+
+  return (
+    <form id="model-provider-setup" className="p-4 flex flex-col gap-3 text-xs min-w-0" onSubmit={(event) => void save(event)}>
+      <p className="text-muted-foreground">{ui("Connection for profile: {0}", profile || "default")}</p>
+      <div className="space-y-1">
+        <Label htmlFor="picker-api-key">{ui("API Key")}</Label>
+        <Input id="picker-api-key" type="password" autoComplete="off" value={apiKey} autoFocus
+          required={!customRoute && !hasKey}
+          placeholder={savedKey ? ui("Already saved; leave blank to keep it") : customRoute ? ui("Optional for local models") : ui("Paste the provider's API key")}
+          onChange={(event) => setApiKey(event.target.value)} />
+      </div>
+      {!custom && <>
+        <p>{ui("Paste your key and import it. Then choose a model from the refreshed list.")}</p>
+        {defaults?.choices && baseUrlEnv && <div className="space-y-1">
+          <Label htmlFor="picker-api-region">{ui("API region / product")}</Label>
+          <select id="picker-api-region" className="w-full border border-border bg-background px-2 py-2 text-xs" value={routingUrl}
+            onChange={(event) => { setRoutingUrl(event.target.value); setRoutingChanged(true); }}>
+            {defaults.choices.map((choice) => <option key={choice.baseUrl} value={choice.baseUrl}>{ui(choice.label)}</option>)}
+          </select>
+        </div>}
+        {defaults && <div className="space-y-1 border border-border/60 bg-muted/20 p-3">
+          <div className="text-muted-foreground">{ui("Default API address")}</div>
+          <div className="font-mono break-all">{routingUrl}</div>
+          <div>{ui("Request format: {0}", defaults.protocol)}</div>
+          <a className="underline" href={defaults.choices?.find((choice) => choice.baseUrl === routingUrl)?.docsUrl || defaults.docsUrl} target="_blank" rel="noreferrer">{ui("Official API documentation")}</a>
+        </div>}
+      </>}
+      <details open={custom ? true : undefined} className="space-y-3">
+      <summary className="cursor-pointer text-muted-foreground">{ui("Advanced: custom API address and protocol")}</summary>
+      {custom && (
+        <div className="space-y-1">
+          <Label htmlFor="picker-connection-name">{ui("Connection name")}</Label>
+          <Input id="picker-connection-name" value={name} required onChange={(event) => setName(event.target.value)} />
+        </div>
+      )}
+      {customRoute && <div className="space-y-1">
+        <Label htmlFor="picker-model-name">{ui("Model name")}</Label>
+        <Input id="picker-model-name" value={modelName} required={!!customRoute}
+          placeholder={ui("Enter a model ID, or select one after saving the key")}
+          onChange={(event) => setModelName(event.target.value)} />
+      </div>}
+      <div className="space-y-1">
+        <Label htmlFor="picker-base-url">{ui("API address (optional for built-in providers)")}</Label>
+        <Input id="picker-base-url" type="url" value={baseUrl} required={!!custom}
+          placeholder={provider.api_url || defaults?.baseUrl || ui("Leave blank to use the provider's default address")}
+          onChange={(event) => setBaseUrl(event.target.value)} />
+        {customRoute && <p className="text-muted-foreground">{ui("A custom API address is saved as a separate connection.")}</p>}
+      </div>
+      {customRoute && (
+        <div className="space-y-1">
+          <Label htmlFor="picker-protocol">{ui("API protocol")}</Label>
+          <select id="picker-protocol" className="w-full border border-border bg-background px-2 py-2 text-xs" value={protocol} onChange={(event) => setProtocol(event.target.value)}>
+            <option value="">{ui("Auto detect")}</option>
+            <option value="chat_completions">OpenAI Chat Completions</option>
+            <option value="codex_responses">OpenAI Responses</option>
+            <option value="anthropic_messages">Anthropic Messages</option>
+          </select>
+        </div>
+      )}
+      </details>
+      <p className="text-muted-foreground">{ui("Importing loads the model catalog without generating a response.")}</p>
+      {error && <p role="alert" className="text-destructive">{error}</p>}
+      <div className="flex flex-wrap justify-end gap-2">
+        <Button type="button" outlined disabled={saving} onClick={onCancel}>{ui("Back to models")}</Button>
+      </div>
+    </form>
+  );
+}
