+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { MemoryRouter } from "react-router";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { I18nProvider } from "@/i18n";
+import type { ModelOptionProvider } from "@hermes/shared";
+
+const apiMocks = vi.hoisted(() => ({
+  getEnvVars: vi.fn(),
+  setEnvVar: vi.fn(),
+  getCustomModelEndpoints: vi.fn(),
+  saveCustomModelEndpoint: vi.fn(),
+}));
+vi.mock("@/lib/api", () => ({ api: apiMocks, getManagementProfile: () => "default" }));
+
+import { ModelPickerDialog } from "./ModelPickerDialog";
+
+let root: Root;
+let container: HTMLDivElement;
+const openai: ModelOptionProvider = {
+  slug: "openai-api", name: "OpenAI API", models: [], authenticated: false,
+  auth_type: "api_key", key_env: "OPENAI_API_KEY", warning: "paste OPENAI_API_KEY to activate",
+};
+
+async function render(providers: ModelOptionProvider[], loader = vi.fn(), profile = "builder") {
+  loader.mockResolvedValueOnce({ providers });
+  const onApply = vi.fn(async () => undefined);
+  container = document.createElement("div");
+  document.body.append(container);
+  root = createRoot(container);
+  await act(async () => root.render(
+    <MemoryRouter><I18nProvider>
+      <ModelPickerDialog profile={profile} loader={loader} alwaysGlobal onApply={onApply} onClose={() => {}} />
+    </I18nProvider></MemoryRouter>,
+  ));
+  return { loader, onApply };
+}
+
+async function click(label: string) {
+  const button = [...document.querySelectorAll("button")].find((entry) => entry.textContent?.trim() === label);
+  expect(button, label).toBeTruthy();
+  await act(async () => button!.click());
+}
+
+async function fill(id: string, value: string) {
+  const input = document.getElementById(id) as HTMLInputElement;
+  expect(input).toBeTruthy();
+  await act(async () => {
+    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, value);
+    input.dispatchEvent(new Event("input", { bubbles: true }));
+  });
+}
+
+async function save() {
+  await click("导入密钥并获取模型");
+}
+
+beforeEach(() => {
+  localStorage.setItem("hermes-locale", "zh");
+  (globalThis as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true;
+  vi.clearAllMocks();
+  apiMocks.getEnvVars.mockResolvedValue({});
+  apiMocks.setEnvVar.mockResolvedValue({ ok: true });
+});
+
+afterEach(async () => {
+  await act(async () => root?.unmount());
+  container?.remove();
+});
+
+describe("model picker connection setup", () => {
+  it("imports only a key using official defaults, refreshes models, then applies the user's selection", async () => {
+    const { loader, onApply } = await render([openai]);
+    loader.mockResolvedValue({ providers: [{ ...openai, authenticated: true, models: ["gpt-fixture"] }] });
+    await click("配置 API / 密钥");
+    expect(document.querySelector("input[type=password]")).toBeTruthy();
+    expect(document.body.textContent).toContain("https://api.openai.com/v1");
+    expect(document.body.textContent).toContain("OpenAI Responses");
+    expect(document.getElementById("picker-model-name")).toBeNull();
+    expect(document.querySelector("details")?.open).toBe(false);
+    expect(document.querySelector("footer button[form='model-provider-setup']")).toBeTruthy();
+    await fill("picker-api-key", "synthetic-test-key");
+    await save();
+    expect(apiMocks.setEnvVar).toHaveBeenCalledWith("OPENAI_API_KEY", "synthetic-test-key", "builder");
+    expect(apiMocks.saveCustomModelEndpoint).not.toHaveBeenCalled();
+    expect(loader).toHaveBeenLastCalledWith({ refresh: true });
+    expect(document.body.textContent).toContain("连接已保存");
+    expect(document.getElementById("picker-api-key")).toBeNull();
+    expect(onApply).not.toHaveBeenCalled();
+    await click("gpt-fixture");
+    await click("切换");
+    expect(onApply).toHaveBeenCalledWith(expect.objectContaining({ provider: "openai-api", model: "gpt-fixture" }));
+  });
+
+  it("shows an actionable empty catalog message instead of silently leaving a zero-model row", async () => {
+    const { loader } = await render([openai]);
+    loader.mockResolvedValue({ providers: [openai] });
+    await click("配置 API / 密钥");
+    await fill("picker-api-key", "synthetic-test-key");
+    await save();
+    expect(document.body.textContent).toContain("密钥已保存，但服务商尚未返回模型");
+    expect(document.getElementById("picker-manual-model")).toBeTruthy();
+  });
+
+  it("uses the China GLM preset without requiring a custom URL or model name", async () => {
+    const zai = { slug: "zai", name: "Z.AI / GLM", models: [], authenticated: false, key_env: "GLM_API_KEY" };
+    apiMocks.getEnvVars.mockResolvedValue({
+      GLM_API_KEY: { provider: "zai", provider_primary: true, is_password: true, is_set: false },
+      GLM_BASE_URL: { provider: "zai", advanced: true, is_password: false, is_set: false },
+    });
+    const { loader } = await render([zai]);
+    loader.mockResolvedValue({ providers: [{ ...zai, authenticated: true, models: ["glm-fixture"] }] });
+    await click("配置 API / 密钥");
+    await act(async () => {
+      const select = document.getElementById("picker-api-region") as HTMLSelectElement;
+      select.value = "https://open.bigmodel.cn/api/paas/v4";
+      select.dispatchEvent(new Event("change", { bubbles: true }));
+    });
+    await fill("picker-api-key", "synthetic-china-key");
+    await save();
+    expect(apiMocks.setEnvVar).toHaveBeenCalledWith("GLM_BASE_URL", "https://open.bigmodel.cn/api/paas/v4", "builder");
+    expect(apiMocks.setEnvVar).toHaveBeenCalledWith("GLM_API_KEY", "synthetic-china-key", "builder");
+    expect(apiMocks.saveCustomModelEndpoint).not.toHaveBeenCalled();
+    expect(document.body.textContent).toContain("glm-fixture");
+  });
+
+  it("creates a custom protocol connection without changing the main assignment", async () => {
+    const { loader, onApply } = await render([openai]);
+    const custom = { slug: "custom:fixture", name: "Fixture", models: ["fixture-model"], aliases: ["fixture"], is_user_defined: true };
+    loader.mockResolvedValue({ providers: [openai, custom] });
+    apiMocks.saveCustomModelEndpoint.mockResolvedValue({ ok: true, id: "fixture", endpoints: [] });
+    await click("新增自定义 API");
+    await fill("picker-connection-name", "Fixture");
+    await fill("picker-model-name", "fixture-model");
+    await fill("picker-base-url", "http://localhost:9000/v1");
+    await act(async () => {
+      const select = document.getElementById("picker-protocol") as HTMLSelectElement;
+      select.value = "anthropic_messages";
+      select.dispatchEvent(new Event("change", { bubbles: true }));
+    });
+    await save();
+    expect(apiMocks.saveCustomModelEndpoint).toHaveBeenCalledWith({
+      name: "Fixture", model: "fixture-model", base_url: "http://localhost:9000/v1",
+      api_mode: "anthropic_messages", discover_models: false,
+    }, "builder");
+    expect(onApply).not.toHaveBeenCalled();
+    await click("切换");
+    expect(onApply).toHaveBeenCalledWith(expect.objectContaining({ provider: "custom:fixture", model: "fixture-model" }));
+  });
+
+  it("keeps an existing custom key when editing a model with a blank key field", async () => {
+    const custom = { slug: "custom:fixture", name: "Fixture", models: ["old-model"], aliases: ["fixture"], is_user_defined: true };
+    apiMocks.getCustomModelEndpoints.mockResolvedValue({ endpoints: [{
+      id: "fixture", name: "Fixture", base_url: "http://localhost:9000/v1", model: "old-model",
+      api_mode: "codex_responses", has_api_key: true, discover_models: true,
+    }] });
+    apiMocks.saveCustomModelEndpoint.mockResolvedValue({ ok: true, id: "fixture", endpoints: [] });
+    const { loader } = await render([custom]);
+    loader.mockResolvedValue({ providers: [custom] });
+    await click("配置 API / 密钥");
+    expect((document.getElementById("picker-protocol") as HTMLSelectElement).value).toBe("codex_responses");
+    await fill("picker-model-name", "new-model");
+    await save();
+    const [body, profile] = apiMocks.saveCustomModelEndpoint.mock.calls[0];
+    expect(body).toMatchObject({ id: "fixture", model: "new-model", api_mode: "codex_responses", discover_models: true });
+    expect(body).not.toHaveProperty("api_key");
+    expect(profile).toBe("builder");
+  });
+
+  it("explains subscription login in Chinese and opens the OpenAI key form directly", async () => {
+    const codex = { slug: "openai-codex", name: "ChatGPT or Codex Subscription", models: [], authenticated: false, auth_type: "oauth_external" };
+    await render([codex, openai]);
+    await click("配置 API / 密钥");
+    expect(document.body.textContent).toContain("此服务商使用账号登录授权");
+    expect(document.body.textContent).not.toContain("run `hermes model`");
+    expect(document.querySelector("a")?.getAttribute("href")).toBe("/env?profile=builder");
+    await click("配置 OpenAI 接口");
+    expect(document.getElementById("picker-api-key")).toBeTruthy();
+  });
+
+  it("opens API configuration for the native unconfigured custom provider row", async () => {
+    await render([{ slug: "custom", name: "custom", models: [], authenticated: false }]);
+    await click("配置 API / 密钥");
+    expect(document.getElementById("picker-connection-name")).toBeTruthy();
+    expect(document.getElementById("picker-base-url")?.getAttribute("required")).not.toBeNull();
+    expect(document.getElementById("picker-protocol")).toBeTruthy();
+    expect(document.body.textContent).not.toContain("此服务商使用账号登录授权");
+  });
+});
